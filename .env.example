# ---------------------------------------------------------------------------
# Supabase project
# Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ---------------------------------------------------------------------------
# Supabase Postgres
# Dashboard -> Connect -> Connection string -> URI
# Use the session pooler (port 5432) for schema, seed, and this API.
# Replace YOUR_PROJECT_REF, YOUR_DATABASE_PASSWORD, and YOUR_REGION.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Auth cookies
# For a cross-site frontend, use COOKIE_SAME_SITE=none and COOKIE_SECURE=true.
# ---------------------------------------------------------------------------
ACCESS_TOKEN_COOKIE=si_access_token
REFRESH_TOKEN_COOKIE=si_refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=
REFRESH_TOKEN_MAX_AGE_DAYS=30
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend (Vite only exposes variables prefixed with VITE_)
# Leave as /api/v1 when using the Vite proxy or same-origin deployment.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1

# ---------------------------------------------------------------------------
# Storage (Supabase Storage, private buckets created by storage:setup)
# ---------------------------------------------------------------------------
STORAGE_TOPIC_BUCKET=topic-files
STORAGE_UPLOAD_BUCKET=quiz-uploads
SIGNED_URL_TTL_SECONDS=120
MAX_FILE_MB=25
MAX_IMAGE_MB=5
DEFAULT_TIMEZONE=Asia/Manila
