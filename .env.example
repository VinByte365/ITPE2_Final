# ---------------------------------------------------------------------------
# Supabase project
# Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ---------------------------------------------------------------------------
# Supabase Postgres
# Dashboard -> Connect -> Connection string -> URI
# Use the session pooler (port 5432) for schema, seed, and this API.
# Replace YOUR_PROJECT_REF, YOUR_DATABASE_PASSWORD, and YOUR_REGION.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# API server
# Local: PORT defaults to 4000. Render/hosts inject PORT; keep HOST=0.0.0.0.
# ---------------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Auth cookies
# Cross-site (Vercel frontend + Render API): COOKIE_SAME_SITE=none, COOKIE_SECURE=true.
# Same-site/local: lax/false is fine.
# ---------------------------------------------------------------------------
ACCESS_TOKEN_COOKIE=si_access_token
REFRESH_TOKEN_COOKIE=si_refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=
REFRESH_TOKEN_MAX_AGE_DAYS=30
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend (Vite only exposes variables prefixed with VITE_)
# Local/dev proxy: leave /api/v1.
# Vercel (separate Render API): set VITE_API_BASE_URL=https://YOUR-RENDER-API.onrender.com/api/v1
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1

# ---------------------------------------------------------------------------
# AI quiz generation (Groq, server-only)
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=60000
# GROQ_MAX_INPUT_CHARS=12000
