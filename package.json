{
  "name": "cspt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/index.js",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm:dev\" \"npm:dev:api\"",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "db:schema": "node server/scripts/apply-schema.js",
    "db:migrate": "node server/scripts/migrate.js",
    "db:seed": "node server/scripts/seed.js",
    "db:seed:lms": "node server/scripts/seed-lms.js",
    "make:admin": "node server/scripts/make-admin.js",
    "storage:setup": "node server/scripts/setup-storage.js",
    "storage:cleanup": "node server/scripts/cleanup-orphans.js",
    "authz:sweep": "node server/scripts/authz-sweep.js",
    "build": "vite build",
    "test": "node --test",
    "docs:progress": "node PLANS/progress.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "db:seed:test-users": "node server/scripts/create-test-users.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
