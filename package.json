    "@supabase/supabase-js": "^2.118.0",
    "bootstrap": "^5.3.8",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "morgan": "^1.12.1",
    "officeparser": "^7.8.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "zod": "^4.6.7"
